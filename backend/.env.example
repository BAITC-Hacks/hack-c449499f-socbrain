# Скопируй в .env и заполни своими значениями. .env в git не попадает.

# external_openai | external_nvidia | local — см. app/stt/__init__.py
STT_PROVIDER=external_nvidia

# ВАЖНО: external_openai и external_nvidia — оба временные, для обкатки
# на этапе разработки (оба вызывают чужой облачный API). По ограничению
# ТЗ ("передача аудио/текста во внешние облачные API запрещена") к
# моменту сдачи STT_PROVIDER должен быть переключён на local.

# Нужен только при STT_PROVIDER=external_openai
OPENAI_API_KEY=

# Нужен только при STT_PROVIDER=external_nvidia (build.nvidia.com -> API key)
NVIDIA_API_KEY=
NVIDIA_LANGUAGE_CODE=ru
