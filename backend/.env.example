# Скопируй в .env и заполни своими значениями. .env в git не попадает.

# external | local — см. app/stt/__init__.py
STT_PROVIDER=external

# Нужен только при STT_PROVIDER=external.
# ВАЖНО: внешний провайдер — временно, для обкатки на этапе разработки.
# По ограничению ТЗ ("передача аудио/текста во внешние облачные API
# запрещена") к моменту сдачи STT_PROVIDER должен быть переключён на local.
OPENAI_API_KEY=
