# Скопируй в .env и заполни своими значениями. .env в git не попадает.

# --- Распознавание речи ------------------------------------------------------
# local | external — см. app/stt/__init__.py
# local    — faster-whisper в контейнере worker, аудио не покидает хост (целевой режим по ТЗ)
# external — OpenAI Whisper API. ВАЖНО: временно, для обкатки на этапе разработки.
#            По ограничению ТЗ ("передача аудио/текста во внешние облачные API
#            запрещена") к моменту сдачи должен быть local.
STT_PROVIDER=local
# tiny | base | small | medium | large-v3 — встраивается в образ при сборке (WHISPER_MODEL в окружении compose)
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
# Пусто = язык по фрагментам (нужно для шала-казахской речи); ru | kk — зафиксировать
WHISPER_LANGUAGE=
# Общий словарь-подсказка; имена участников добавляются из карточки совещания автоматически
WHISPER_PROMPT=Совещание. Поручения, ответственные, сроки. Самрук-Қазына.
CPU_THREADS=4

# --- Диаризация --------------------------------------------------------------
# 0 = определить автоматически (если в карточке указаны участники — берётся их число)
NUM_SPEAKERS=0
DIARIZATION_THRESHOLD=0.5

# --- Анализ стенограммы (LLM) ---------------------------------------------------
# openai | nvidia — облако: ТЕКСТ стенограммы уходит во внешний API (только для разработки)
# ollama | vllm   — локально, для закрытого контура (ollama: docker compose --profile local-llm up -d)
# none            — без LLM, поручения по шаблонам
LLM_PROVIDER=openai
# Пусто = модель по умолчанию (openai: gpt-4.1-mini, nvidia: meta/llama-3.3-70b-instruct, ollama: qwen2.5:3b)
LLM_MODEL=
# Свой OpenAI-совместимый адрес, например vLLM в контуре: http://10.0.0.5:8000/v1
LLM_BASE_URL=
LLM_TIMEOUT=300

# Ключи. Нужны только облачным провайдерам. Можно не задавать здесь, а вставить в интерфейсе:
# Настройки → Распознавание речи и ИИ (хранятся зашифрованными, ключ из интерфейса главнее .env).
OPENAI_API_KEY=
NVIDIA_API_KEY=

# --- Шаблон: NVIDIA ------------------------------------------------------------
# Облако (разработка): ключ на https://build.nvidia.com → модель → «Get API Key», вида nvapi-…
#   LLM_PROVIDER=nvidia
#   LLM_MODEL=meta/llama-3.3-70b-instruct
#   NVIDIA_API_KEY=nvapi-...
# Та же модель в закрытом контуре (сдача по ТЗ): контейнер NVIDIA NIM на своём GPU-сервере,
# тот же OpenAI-совместимый API — меняется только адрес, ключ не нужен:
#   LLM_PROVIDER=nvidia
#   LLM_BASE_URL=http://<gpu-сервер>:8000/v1
#   LLM_MODEL=meta/llama-3.3-70b-instruct
# Проверка: Настройки → «Распознавание речи и ИИ» → «Проверить подключение» (или POST /api/llm/check).

# Мастер-ключ шифрования секретов из интерфейса (Fernet). Пусто — создаётся /data/.secrets_key.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=

# --- Прочее ------------------------------------------------------------------
TZ=Asia/Almaty
# За сколько дней до срока поручение попадает в напоминания
REMIND_DAYS_BEFORE=2
