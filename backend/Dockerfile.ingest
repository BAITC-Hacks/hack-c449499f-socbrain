FROM python:3.12-slim-bookworm AS receiver
WORKDIR /srv
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 INGEST_DATA_DIR=/data
COPY requirements-ingest.txt ./
RUN pip install --no-cache-dir -r requirements-ingest.txt && mkdir /data && chown 10001:10001 /data
COPY app ./app
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8020/health', timeout=3).close()"]
CMD ["uvicorn", "app.receiver:app", "--host", "0.0.0.0", "--port", "8020"]

FROM receiver AS stt-worker
USER root
COPY requirements-local.txt ./
RUN pip install --no-cache-dir -r requirements-local.txt && python -c "import faster_whisper"
ENV HF_HUB_OFFLINE=1 WHISPER_MODEL=/models/faster-whisper-small
USER 10001:10001
HEALTHCHECK NONE
CMD ["python", "-m", "app.ingest_worker"]
