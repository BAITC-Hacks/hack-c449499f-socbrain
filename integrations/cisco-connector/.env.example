GATEWAY_API_KEY=
CMS_URL=
CMS_USERNAME=
CMS_PASSWORD=
CMS_CA_FILE=
CMS_BOT_SIP_URI=
# Separate CMS Scheduler HTTPS origin, usually a different port such as 8443.
CMS_SCHEDULER_URL=
# Optional, independent credentials for the Scheduler deployment/proxy.
CMS_SCHEDULER_USERNAME=
CMS_SCHEDULER_PASSWORD=

CONNECTOR_DATA_DIR=/data
ASSISTANT_ENABLED=false
PARTICIPANTS_NOTIFIED=false
# Comma-separated allowed coSpace UUIDs. Only these meetings are recorded.
ASSISTANT_SPACES=
POLL_SECONDS=15
SCHEDULE_LIMIT=1000

# SIP identity and routing supplied by your Cisco administrator.
SIP_ID_URI=
SIP_DOMAIN=
SIP_TRANSPORT=udp
SIP_PORT=5060
SIP_BIND_ADDRESS=0.0.0.0
SIP_PUBLIC_ADDRESS=
SIP_RTP_PORT=40000
# 0=disabled, 1=optional, 2=mandatory SRTP; match the CMS/SBC policy.
SIP_SRTP=1
SIP_CA_FILE=/etc/ssl/certs/ca-certificates.crt
SIP_REGISTRAR=
SIP_PROXY=
SIP_REALM=*
SIP_USERNAME=
SIP_PASSWORD=

# Full upload endpoint of YOUR application, not a Cisco endpoint.
APP_UPLOAD_URL=
APP_CONTRACT=gateway
APP_API_KEY=
APP_CA_FILE=
APP_ALLOW_HTTP=false
# Set true for the included SOCBrain receiver, which enforces Idempotency-Key.
APP_IDEMPOTENT=false
