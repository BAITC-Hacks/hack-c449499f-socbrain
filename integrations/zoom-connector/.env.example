ZOOM_CONNECTOR_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Comma-separated Zoom user IDs or emails whose calendars are cached.
ZOOM_USER_IDS=
CALENDAR_POLL_SECONDS=300
ZOOM_RECORDING_TYPES=AUDIO_ONLY,M4A,MP4
ZOOM_MAX_DOWNLOAD_BYTES=2147483648
ZOOM_DATA_DIR=/data
WORKER_POLL_SECONDS=2

# Set true only after users are informed about recording/transcription.
PARTICIPANTS_NOTIFIED=false
APP_UPLOAD_URL=
APP_API_KEY=
APP_CA_FILE=
APP_ALLOW_HTTP=false

# RTMS app credentials may be the same app or a separate RTMS-enabled app.
ZOOM_RTMS_ENABLED=false
ZOOM_RTMS_CLIENT_ID=
ZOOM_RTMS_CLIENT_SECRET=
# Manual REST start has Zoom invitee/join/host restrictions; prefer account auto-start.
ZOOM_RTMS_AUTO_START=false
